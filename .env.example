# Copy to .env and fill in. Never commit .env.
# Every key here maps to a field on app.config.Settings (case-insensitive).

# ---- LLM (Groq) -----------------------------------------------------------
# Groq is the ONLY LLM provider in this project. There is no OpenAI key and no
# request to api.openai.com: the `openai` package is used purely as an SDK for
# Groq's OpenAI-compatible endpoint at LLM_BASE_URL.
#
# DEVIATION from PRD C8, which names OpenAI `gpt-4o-mini`. PRD §16 permits
# "an OpenAI-compatible LLM endpoint", which is what Groq serves. No extra
# dependency - the `openai` client is simply pointed at LLM_BASE_URL.
#
# Leave the key blank to run the deterministic extractive fallback (no network).
# Set ENV=eval to force that fallback even when a key IS present.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=20

# ---- Embedding / vector store ---------------------------------------------
# PRD C4 mandates this exact model. It runs LOCALLY through sentence-transformers
# and is the only embedder in the project: embeddings are never sent to an API,
# Groq included. The ~90 MB download comes from the HuggingFace Hub on first run
# and is cached; after that embedding is fully offline (PRD NFR-3).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hard limit in word-pieces. Chunks above this are silently truncated.
EMBED_MAX_SEQ_LENGTH=256
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=mf_faq_v1

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_OVER_FETCH=8
# COSINE SIMILARITY, not cosine distance.
MIN_SIMILARITY=0.25
USE_MMR=true
MMR_LAMBDA=0.7

# ---- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=240
CHUNK_OVERLAP_TOKENS=60
MIN_SECTION_TOKENS=40
MAX_TABLE_ROWS=12
MAX_TABLE_CHARS=1800

# ---- Ingestion -------------------------------------------------------------
FETCH_DELAY_S=1.5
FETCH_TIMEOUT_S=30
FETCH_RETRIES=3
USER_AGENT=MF-Facts-Bot/0.1 (academic RAG demo; contact: student@example.edu)

# ---- Answer / UI -----------------------------------------------------------
MAX_SENTENCES=3
MAX_CHAT_HISTORY_TURNS=3
# "eval" disables the LLM even when a key is present, making eval runs
# deterministic and network-free.
ENV=demo
